#!/bin/sh
set -eu

credential_directory=${CREDENTIALS_DIRECTORY:-}
credential_file=${credential_directory}/op_service_account_token

if [ -z "${credential_directory}" ] || [ ! -r "${credential_file}" ]; then
  echo '{"event":"op_credential_unavailable","level":"error"}' >&2
  exit 78
fi

OP_SERVICE_ACCOUNT_TOKEN=$(tr -d '\r\n' <"${credential_file}")
case "${OP_SERVICE_ACCOUNT_TOKEN}" in
  ops_*) ;;
  *)
    echo '{"event":"op_credential_prefix_invalid","level":"error"}' >&2
    exit 78
    ;;
esac
export OP_SERVICE_ACCOUNT_TOKEN

exec /usr/bin/op run \
  --env-file=/etc/itecs-ai-codex-slack/op.env \
  -- /usr/bin/node \
  /home/itecs/itecs.ai/ops/slack-codex-bridge/dist/src/index.js \
  "$@"
