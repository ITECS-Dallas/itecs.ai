#!/bin/sh
set -eu

target=/etc/credstore.encrypted/itecs-ai-codex-op.cred

if [ "$(id -u)" -ne 0 ]; then
  echo "Run this command with sudo." >&2
  exit 1
fi
if [ -e "${target}" ]; then
  echo "The encrypted credential already exists; it was not overwritten." >&2
  exit 1
fi
if [ ! -c /dev/tty ]; then
  echo "A controlling terminal is required." >&2
  exit 1
fi

restore_tty() {
  stty echo </dev/tty 2>/dev/null || true
}
trap restore_tty EXIT HUP INT TERM

printf "1Password service-account token: " >/dev/tty
stty -echo </dev/tty
IFS= read -r service_account_token </dev/tty
stty echo </dev/tty
printf "\n" >/dev/tty
trap - EXIT HUP INT TERM

case "${service_account_token}" in
  ops_*) ;;
  *)
    service_account_token=
    echo "The service-account token prefix is invalid." >&2
    exit 1
    ;;
esac

umask 077
install -d -m 0700 /etc/credstore.encrypted
printf "%s" "${service_account_token}" |
  systemd-creds encrypt \
    --name=op_service_account_token \
    - \
    "${target}"
service_account_token=
chown root:root "${target}"
chmod 0600 "${target}"
echo "Encrypted systemd credential installed at ${target}."
